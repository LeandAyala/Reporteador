{% extends 'base.html.twig' %}
{% block body %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/json-formatter-js@2.5.9/dist/json-formatter.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/mode/sql/sql.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/json-formatter-js@2.5.9/dist/json-formatter.umd.min.js"></script>
    <style>
        * {
            font-size: 13px;
        }

        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            position: relative;
        }

        .montserrat {
            font-family: "Montserrat", serif;
            font-optical-sizing: auto;
            font-weight: 700;
            font-style: normal;
        }

        .montserrat-text {
            font-family: "Montserrat", serif;
            font-optical-sizing: auto;
            font-weight: 500;
            font-style: normal;
        }

        .btn.dropdown-toggle.bs-placeholder.btn-light, .btn.dropdown-toggle.btn-light {
            border: 1px solid #d0d4da;
        }

        .listado {
            max-height:780px;
        }

        .listado::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .listado::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 20px;
        }

        .listadoInformes {
            max-height:680px;
        }

        .listadoInformes::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .listadoInformes::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 20px;
        }

        @media (max-height:641px) {
            .listadoInformes {
                max-height:397px;
            }
        }

        body::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        body::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 20px;
        }

        .logo {
            animation: animarLogo 2s linear infinite;
        }
        
        .loader {
            top: 2px;
            left: 10px;
            width: 40px;
            height: 40px;
            display: block;
            position:absolute;
            border-radius: 50%;
            border: 6px solid #f3f3f3;
            border-top: 6px solid #007BFF;
            animation: spin 2s linear infinite, cambiarColorLogo 20s linear infinite;
        }

        @keyframes in-circle-swoop {
            from {
                clip-path: var(--circle-top-right-out);
            }
            to {
                clip-path: var(--circle-bottom-right-in);
            }
        }

        [transition-style="in:custom:circle-swoop"] {
            --transition__duration: 1s;
            animation-name: in-circle-swoop;
        }

        @keyframes out-circle-swoop {
            from {
                clip-path: var(--circle-bottom-right-in);
            }
            to {
                clip-path: var(--circle-top-right-out);
            }
        }

        [transition-style="out:custom:circle-swoop"] {
            --transition__duration: 1s;
            --transition__easing: cubic-bezier(.30, 1, .25, 1);
            animation-name: out-circle-swoop;
        }

        @keyframes spin {
            0% {transform: rotate(0deg)}
            100% {transform: rotate(360deg)}
        }

        @keyframes animarLogo {
            0% {transform:scale(0.2)}
            50% {transform:scale(0.3)}
            100% {transform:scale(0.2)}
        }

        @keyframes cambiarColorLogo {
            0% {border-top: 6px solid #007BFF}
            50% {border-top: 6px solid #28A745}
            75% {border-top: 6px solid #DC3545}
            100% {border-top: 6px solid #007BFF}
        }

        .modal-lg {
            max-width:1200px;
        }

        .CodeMirror {
            height: 120px;
            resize: vertical;
            min-height: 120px;
            max-height: 400px;
            border-radius: 5px;
            border: 1px solid #d0d4da;
        }

        .CodeMirror-linenumber {
            text-align: center;
        }

        #errorValidarSql:hover {
            background: #DC3545 !important;
        }

        .btnCerrarError:hover {
            box-shadow: 0px 0px 8px 0px;
        }

        .lineaError {
            border-radius: 3px;
            transition: all 0.5s ease;
            background: #DC354526 !important;
        }

        .camposJson:hover div {
            background: #007BFF !important;
        }   

        .camposJson:hover span {
            color: #007BFF;
        }  

        .divAgregarConfiguracion:hover {
            border:1px solid #17A2B8 !important;
            border-style:dashed !important;
        }

        .divAgregarConfiguracion:hover * {
            color:#17A2B8 !important;
        }

        .optionConfiguraciones {
            font-size: 12px;
        }

        .card-info {
            width: 350px;
            border-radius: 15px;
            background: #007BFF;
            padding: 7px;
            overflow: hidden;
            box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 20px 0px;
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .card-info .top-section {
            height: 201px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            background: white;
            position: relative;
        }

        .card-info .top-section .border {
            border-bottom-right-radius: 12px;
            height: 30px;
            width: 257px;
            background: white;
            background: #007BFF;
            position: relative;
            transform: skew(-40deg);
            box-shadow: -10px -10px 0 0 #007BFF;
        }

        .card-info .top-section .border::before {
            content: "";
            position: absolute;
            width: 15px;
            height: 15px;
            top: 0;
            right: -15px;
            background: rgba(255, 255, 255, 0);
            border-top-left-radius: 10px;
            box-shadow: -5px -5px 0 2px #007BFF;
        }

        .card-info .top-section::before {
            content: "";
            position: absolute;
            top: 30px;
            left: 0;
            background: rgba(255, 255, 255, 0);
            height: 15px;
            width: 15px;
            border-top-left-radius: 15px;
            box-shadow: -5px -5px 0 2px #007BFF;
        }

        .card-info .top-section .icons {
            position: absolute;
            top: 0;
            width: 100%;
            height: 30px;
            display: flex;
            justify-content: space-between;
        }

        .card-info .top-section .icons .logoPopover {
            height: 100%;
            aspect-ratio: 1;
            padding: 7px 0 7px 15px;
        }

        .card-info .top-section .icons .logoPopover .top-section {
            height: 100%;
        }

        .card-info .top-section .icons .social-media {
            height: 100%;
            padding: 8px 15px;
            display: flex;
            gap: 7px;
        }

        .card-info .top-section .icons .social-media .svg {
            height: 100%;
            fill: #007BFF;
        }

        .card-info .top-section .icons .social-media .svg:hover {
            fill: white;
        }

        .card-info .bottom-section {
            margin-top: 10px;
        }

        .card-info .bottom-section .title {
            display: block;
            font-size: 14px;
            font-weight: bolder;
            color: white;
            text-align: center;
        }

        .card-info .bottom-section .row {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .card-info .bottom-section .row .item {
            flex: 30%;
            text-align: center;
            padding: 5px;
            color: rgba(170, 222, 243, 0.721);
        }

        .card-info .bottom-section .row .item .big-text {
            font-size: 12px;
            display: block;
        }

        .card .bottom-section .row .item .regular-text {
            font-size: 9px;
        }

        .card-info .bottom-section .row .item:nth-child(2) {
            border-left: 1px solid rgba(255, 255, 255, 0.126);
            border-right: 1px solid rgba(255, 255, 255, 0.126);
        }

        .border {
            border:none !important;
        }

        .opciones:hover {
            border-radius:50%;
            box-shadow: 0px 0px 4px 0px;
        }

        .btnTooltip {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            width: 25px;
            height: 25px;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition-duration: .3s;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.199);
            background-color: rgb(163, 142, 255);
        }

        .sign {
            width: 100%;
            transition-duration: .3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sign svg {
            width: 17px;
        }

        .sign svg path {
            fill: white;
        }

        .textBtn {
            position: absolute;
            top: 4px;
            right: 0%;
            opacity: 0;
            width: 200px;
            color: white;
            font-size: 12px;
            transition-duration: .3s;
        }

        .btnTooltip:hover {
            width: 100px;
            border-radius: 40px;
            transition-duration: .3s;
        }

        .btnTooltip:hover .sign {
            width: 30%;
            transition-duration: .3s;
            padding-left: 0px;
        }

        .btnTooltip:hover .textBtn {
            opacity: 1;
            width: 70%;
            transition-duration: .3s;
            padding-right: 18px;
        }

        .textBtn:active {
            transform: translate(2px ,2px);
        }

        .tooltip {
            gap:5px;
            top: -20px;
            opacity: 0;
            width:150px;
            height:23px;
            left: -163px;
            color: white;
            display: flex;
            font-size:11px;
            font-weight:bold;
            padding: 3px 10px;
            border-radius: 5px;
            position: absolute;
            align-items: center;
            pointer-events: none;
            justify-content: center;
            transition-duration: .2s;
            background-color: #17A2B8e3;
        }

        .tooltip::before {
            width: 0px;
            right: -8px;
            height: 0px;
            bottom: 8px;
            content: "";
            position: absolute;
            background-size: 1000%;
            transform: rotate(180deg);
            transition-duration: .3s;
            background-position: center;
            border-top: 4px solid transparent;
            border-right: 8px solid #17A2B8e3;
            border-bottom: 4px solid transparent
        }
        
        .msg:hover .tooltip {
            top: -3px;
            opacity: 1;
            transition-duration: .3s;
        }

        .msg:hover {
            background-position: right;
            transition-duration: .5s;
        }

        .migracionEjecutada::before {
            top: 0px;
            width: 0%;
            left: 0px;
            content: "";
            height: 100%;
            position: absolute;
            background: #28A745;
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .migracionEjecutada:hover span {
            color: white;
        }

        .migracionEjecutada:hover::before {
            width: 100%;
        }

        .migracionSinEjecutar::before {
            top: 0px;
            width: 0%;
            left: 0px;
            content: "";
            height: 100%;
            position: absolute;
            background: #DC3545;
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .migracionSinEjecutar:hover span {
            color: white;
        }

        .migracionSinEjecutar:hover::before {
            width: 100%;
        }

        .tooltipMigracionEjecutada::before {
            border-right: 8px solid #28A745e3;
        }

        .tooltipMigracionSinEjecutar::before {
            border-right: 8px solid #DC3545e3;
        }

        .msg:hover .tooltipMigracion {
            top: -1px;
        }
    </style>
    <div class="container-fluid pt-4" data-turbo="true" {{ stimulus_controller('facturas--reporteador',
        {
            'urlObtenerInforme' : path('facturas_obtener_informe'),
            'urlGuardarInforme' : path('facturas_guardar_informe'),
            'urlEliminarInforme' : path('facturas_eliminar_informe'),
            'urlPublicarInforme' : path('facturas_publicar_informe'),
            'urlFrameListaInformes' : path('facturas_frame_lista_informes')
        }
    )}}>
        <div class="col-12 animate__animated animate__fadeIn" style="display:flex; align-items:center; justify-content:center">
            <div class="card shadow-lg p-0 mb-5 bg-white rounded" style="width:100%">
                <div class="card-body" style="overflow:hidden">
                    <div class="list-group-item active font-weight-bold" style="border-radius:5px 5px 0px 0px; display:flex; align-items:center; justify-content:space-between">
                        <span>Configuración de informes</span>
                        <span id="totalRegistros"></span>
                    </div>
                    <div class="list-group-item">
                        {{ form_start(formFiltrosInforme, {'attr' : {'class' : 'mb-0', 'data-action' : 'facturas--reporteador#enviarFiltrosInforme', 'data-facturas--reporteador-target' : 'formFiltrosInforme'}})}}
                            <div class="row">
                                <div class="col-6 pr-0">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            {{ form_label(formFiltrosInforme.modulo,formFiltrosInforme.modulo, {'label_attr' : {'class' : 'input-group-text font-weight-bold'}}) }}
                                        </div>
                                        {{ form_widget(formFiltrosInforme.modulo, {'attr' : {'class' : 'form-control custom-select'}})}}
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            {{ form_label(formFiltrosInforme.tipo,formFiltrosInforme.tipo, {'label_attr' : {'class' : 'input-group-text font-weight-bold'}}) }}
                                        </div>
                                        {{ form_widget(formFiltrosInforme.tipo, {'attr' : {'class' : 'form-control', 'onkeypress' : 'return event.charCode >= 48 && event.charCode <= 57' }})}}
                                        <button type="submit" class="btn btn-success" id="btnBuscarInformes" style="margin-left:10px"><i class="fas fa-search"></i></button>
                                    </div>
                                </div>
                            </div>
                        {{ form_end(formFiltrosInforme) }}
                    </div>
                    <div class="list-group-item">
                        <div style="display:none" data-facturas--reporteador-target="cargandoListaInformes" id="cargandoListaInformes">
                            <div class="animate__animated animate__fade" style="position:absolute; width:100%; height:100%; background:white; z-index:2; left:0; top:0; opacity:0.6"></div>
                            <div class="animate__animated animate__flipInX" style="position:absolute; z-index:3; width:100%; height:100%; left:0; top:0; display:flex; align-items:center; justify-content:center">
                                <div style="background:white; width: 470px; display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 15px; border:1px solid #d1d4da;">
                                    <div style="position:relative;">
                                        <div class="loader"></div>
                                        <img src="{{ asset('Imgs/logo.png') }}" class="logo">
                                    </div>
                                    <b style="font-size:13px">Cargando información...</b>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item p-0" style="border:none" id="frameListaInformes">
                            <div class="text-danger" style="display:flex; align-items:center; justify-content:center; font-weight:bold; height:50px">
                                ¡No se encontraron registros para listar!
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <button type="button" id="btnNuevoInforme" class="btn btn-primary" data-id="0" data-action="facturas--reporteador#showModalNuevoInforme"><i class="fas fa-external-link-alt"></i> Nuevo</button>
                        <button type="button" id="btnRegresar" class="btn btn-danger"><i class="fas fa-caret-left"></i> Regresar</button>
                    </div>
                </div>
            </div>      
        </div>

        {# Modal para visualizar crear/editar informes #}
        {# ------------------------------------------- #}

        <div id="modalNuevoInforme" class="modal fade">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header btn-primary font-weight-bold" style="display:flex; align-items:center">
                        <div id="divTituloNuevoInforme" style="display:flex; align-items:center">
                            <i class="fas fa-external-link-alt" style="font-size:12px" id="iconoNuevoInforme"></i>
                            <span style="margin-left:5px" id="tituloNuevoInforme">Nuevo informe</span>
                        </div>
                        <button type="button" class="close" onclick="$('#modalNuevoInforme').modal('hide')">&times;</button>
                    </div>
                    <div class="modal-body">
