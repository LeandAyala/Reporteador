                                            <i class="fas fa-tag" style="font-size:12px"></i>
                                        </div>
                                        <input id="inputColspanCabecera{{ key }}" type="text" class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" style="font-size:11px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Colspan" value="{{ (cabecera.colspan is defined) ? cabecera.colspan : '' }}">
                                    </div>
                                    <div style="display:flex; position:relative; width:14px; justify-content:end">
