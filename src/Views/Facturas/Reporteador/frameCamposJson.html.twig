                                        </div>
                                        <div style="display:flex; position:relative; width:14px; justify-content:end">
                                            <i class="fas fa-trash text-danger" data-key="parametrosRutaFrame{{ key }}" style="cursor:pointer" data-action="click->facturas--reporteador#eliminarParametro"></i>
                                        </div>
                                    </div>
