<div class="list-group-item animate__animated animate__fadeIn" style="border:none">
    <div class="row">
        <div class="col-12">
            <div style="display:flex; flex-direction:column; gap:3px; padding-right:2px;">
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#rutaFrameInforme').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-paper-plane" style="font-size:8px; color:white; margin-left:-1px"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Ruta frame informe</span>
                </div>
                <div id="rutaFrameInforme" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div style="width:100%; display:flex; gap:10px; position:relative">
                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                            <i class="fas fa-link" style="font-size:10px"></i>
                        </div>
                        <input type="text" id="inputRutaFrameInforme" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Ruta frame informe" value="{{ (configuraciones.rutaFrameInforme is defined) ? configuraciones.rutaFrameInforme : '' }}">
                    </div>
                </div>
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#periodo').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-scroll" style="font-size:8px; color:white;"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Periodo</span>
                </div>
                <div id="periodo" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div style="width:100%; display:flex; gap:10px; position:relative">
                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                            <i class="fas fa-check" style="font-size:12px"></i>
                        </div>
                        <input type="text" id="periodoInforme" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Periodo" value="{{ (configuraciones.periodo is defined) ? configuraciones.periodo : '' }}">
                    </div>
                </div>
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#anchoTabla').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-arrows-alt-h" style="font-size:10px; color:white;"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Ancho de tabla</span>
                </div>
                <div id="anchoTabla" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div style="width:100%; display:flex; gap:10px; position:relative">
                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                            <i class="fas fa-check" style="font-size:12px"></i>
                        </div>
                        <input type="text" id="anchoTablaInforme" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Ancho de tabla" value="{{ (configuraciones.anchoTabla is defined) ? configuraciones.anchoTabla : '' }}">
                    </div>
                </div>
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#cabecera').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-bookmark" style="font-size:8px; color:white;"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Cabecera</span>
                </div>
                <div id="cabecera" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div id="listCabeceras" style="display:flex; width:100%; gap:3px; flex-direction:column; margin-top:2px">
                        {% if configuraciones.cabecera is defined and configuraciones.cabecera|length > 0 %}
                            {% for key, cabecera in configuraciones.cabecera %}
                                <div class="cabecera" data-key="{{ key }}" id="cabecera{{ key }}" style="display:flex; align-items:center; border:1px solid #d0d4da; width:100%; padding:8px 10px; border-radius:5px; gap:7px">
                                    <div style="display:flex; position:relative; flex:1">
                                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:13px; border: 1px solid #d0d4da;">
                                            <i class="fas fa-check" style="font-size:12px"></i>
                                        </div>
                                        <input id="inputNombreCabecera{{ key }}" type="text" class="form-control" style="font-size:11px; border-radius:15px 7px 7px 15px; padding-left:40px" value="{{ (cabecera.nombre is defined) ? cabecera.nombre : '' }}" placeholder="Nombre cabecera">
                                    </div>
                                    <div style="display:flex; position:relative; width:150px">
                                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:13px; border: 1px solid #d0d4da;">
                                            <i class="fas fa-tag" style="font-size:12px"></i>
                                        </div>
                                        <input id="inputColspanCabecera{{ key }}" type="text" class="form-control" onkeypress="return event.charCode >= 48 && event.charCode <= 57" style="font-size:11px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Colspan" value="{{ (cabecera.colspan is defined) ? cabecera.colspan : '' }}">
                                    </div>
                                    <div style="display:flex; position:relative; width:14px; justify-content:end">
                                        <i class="fas fa-trash text-danger" data-key="cabecera{{ key }}" style="cursor:pointer" data-action="click->facturas--reporteador#eliminarCabecera"></i>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="divAgregarConfiguracion" data-action="click->facturas--reporteador#agregarCabecera" style=
                    "   
                        display:flex; 
                        padding:10px; 
                        margin-top:5px; 
                        cursor:pointer;
                        border-radius:5px; 
                        align-items:center; 
                        justify-content:center; 
                        transition:all 0.5s ease;
                        border:1px solid #d1d4da; 
                        border-style:dashed; gap:5px; 
                    ">
                        <i class="fas fa-plus" style="font-size:9px; color:gray; transition:all 0.5s ease;"></i>
                        <span style="font-size:10px; color:#808080e0; font-weight:bold; transition:all 0.5s ease;">Agregar cabecera</span>
                    </div>
                </div>
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#campos').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-check" style="font-size:9px; color:white;"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Campos</span>
                </div>
                <div id="campos" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div style="display:flex; flex-direction:column; gap:10px">
                        {% if configuraciones.campos is defined and configuraciones.campos|length > 0 %}
                            {% for key, campo in configuraciones.campos %}
                                <div class="campos" data-key="{{ key }}" style="display:flex; width:100%; flex-direction:column; gap:5px; border:1px solid #d0d4da; border-radius:5px; padding:12px; position:relative; margin-top:20px">
                                    <div class="montserrat" style="position:absolute; display:flex; align-items:center; justify-content:center; font-size:9px; border-radius:10px 0px; background:#FFC107; padding:3px 10px; top:-22px; min-width:95px; left:1px">
                                        {{ campo.nombre }}
                                    </div>
                                    <div style="display:flex; width:100%; gap:7px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-check" style="font-size:12px"></i>
                                            </div>
                                            <input type="text" id="inputNombreCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px; pointer-events:none" placeholder="Nombre" value="{{ (campo.nombre is defined) ? campo.nombre : '' }}">
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-bookmark" style="font-size:10px"></i>
                                            </div>
                                            <input type="text" id="inputTituloCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Título" value="{{ (campo.titulo is defined) ? campo.titulo : '' }}">
                                        </div>
                                    </div>
                                    <div style="display:flex; width:100%; gap:7px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-tag" style="font-size:12px"></i>
                                            </div>
                                            <select class="form-control custom-select" id="selectTipoDatoCampo{{ key }}" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px">
                                                <option class="optionConfiguraciones" value="texto" {{ (campo.tipoDato is defined and campo.tipoDato == 'texto') ? 'selected' : '' }}>texto</option>
                                                <option class="optionConfiguraciones" value="numero" {{ (campo.tipoDato is defined and campo.tipoDato == 'numero') ? 'selected' : '' }}>numero</option>
                                                <option class="optionConfiguraciones" value="moneda" {{ (campo.tipoDato is defined and campo.tipoDato == 'moneda') ? 'selected' : '' }}>moneda</option>
                                                <option class="optionConfiguraciones" value="fecha" {{ (campo.tipoDato is defined and campo.tipoDato == 'fecha') ? 'selected' : '' }}>fecha</option>
                                            </select>
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-align-left" style="font-size:12px"></i>
                                            </div>
                                            <select class="form-control custom-select" id="selectAlineacionTitulo{{ key }}" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px">
                                                <option class="optionConfiguraciones" value="">Alineación título</option>
                                                <option class="optionConfiguraciones" value="izquierda" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'izquierda') ? 'selected' : '' }}>izquierda</option>
                                                <option class="optionConfiguraciones" value="derecha" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'derecha') ? 'selected' : '' }}>derecha</option>
                                                <option class="optionConfiguraciones" value="centro" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'centro') ? 'selected' : '' }}>centro</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div style="display:flex; width:100%; gap:7px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-link" style="font-size:10px"></i>
                                            </div>
                                            <input type="text" id="inputRutaCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Ruta campo" value="{{ (campo.ruta is defined) ? campo.ruta : '' }}">
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-align-right" style="font-size:12px"></i>
                                            </div>
                                            <select class="form-control custom-select" id="selectAlineacionCampo{{ key }}" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px">
                                                <option class="optionConfiguraciones" value="">Alineación campo</option>
                                                <option class="optionConfiguraciones" value="izquierda" {{ (campo.alineacionCampo is defined and campo.alineacionCampo == 'izquierda') ? 'selected' : '' }}>izquierda</option>
                                                <option class="optionConfiguraciones" value="derecha" {{ (campo.alineacionCampo is defined and campo.alineacionCampo == 'derecha') ? 'selected' : '' }}>derecha</option>
                                                <option class="optionConfiguraciones" value="centro" {{ (campo.alineacionCampo is defined and campo.alineacionCampo == 'centro') ? 'selected' : '' }}>centro</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div style="display:flex; width:100%; margin-top:10px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fab fa-html5" style="font-size:13px"></i>
                                            </div>
                                            <textarea id="inputHtmlCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px; min-height:70px" placeholder="html">{{ campo.html }}</textarea>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-danger" style="display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:10px">¡No hay campos configurados!</div>
                        {% endif %}
                    </div>
                </div>
                <div class="bg-light camposJson" style="display:flex; align-items:center; border-radius:5px; padding:10px; border:1px solid #d0d4da; gap:5px; cursor:pointer" onclick="$('#agrupamiento').toggle('400')">
                    <div style=
                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-layer-group" style="font-size:9px; color:white; margin-top:-1px"></i>
                    </div>
                    <span class="montserrat" style="font-size:11px; transition:all 0.5s ease">Agrupamiento</span>
                </div>
                <div id="agrupamiento" style="border-radius:0px 0px 5px 5px; padding:15px; border:1px solid #d0d4da; display:none; margin-top:-4px; margin-left:2px; margin-right:2px">
                    <div id="listAgrupamiento" style="display:flex; width:100%; gap:3px; flex-direction:column; margin-top:2px">
                        {% if configuraciones.agrupamiento is defined and configuraciones.agrupamiento|length > 0 and configuraciones.agrupamiento[0].campos is defined %}
                            {% for key, agrupamiento in configuraciones.agrupamiento[0].campos %}
                                <div class="agrupamiento" data-key="{{ key }}" id="agrupamiento{{ key }}" style="display:flex; align-items:center; border:1px solid #d0d4da; width:100%; padding:8px 10px; border-radius:5px; gap:7px">
                                    <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                            <i class="fas fa-tag" style="font-size:12px"></i>
                                        </div>
                                        <select class="form-control custom-select selectAgrupamiento" data-seleccion="{{ agrupamiento.nombre }}" data-clase="selectAgrupamiento" id="selectAgrupamiento{{ key }}" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" data-action="facturas--reporteador#seleccionarOpcion">
                                            {% for campo in campos %}
                                                {% if campo not in camposAgrupacion or campo == agrupamiento.nombre %}
                                                    <option class="optionConfiguraciones" value="{{ campo }}" {{ (agrupamiento.nombre is defined and agrupamiento.nombre == campo) ? 'selected' : '' }}>{{ campo }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div style="display:flex; position:relative; flex:1">
                                        <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:13px; border: 1px solid #d0d4da;">
                                            <i class="fas fa-check" style="font-size:12px"></i>
                                        </div>
                                        <input id="inputAgrupamiento{{ key }}" type="text" class="form-control" style="font-size:11px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Título agrupamiento" value="{{ (agrupamiento.titulo is defined) ? agrupamiento.titulo : '' }}">
                                    </div>
                                    <div style="display:flex; position:relative; width:14px; justify-content:end">
                                        <i class="fas fa-trash text-danger" data-key="agrupamiento{{ key }}" style="cursor:pointer" data-action="click->facturas--reporteador#eliminarAgrupamiento"></i>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="divAgregarConfiguracion" data-action="click->facturas--reporteador#agregarAgrupamiento" style=
                    "   
                        display:flex; 
                        padding:10px; 
                        margin-top:5px; 
                        cursor:pointer;
                        border-radius:5px; 
                        align-items:center; 
                        justify-content:center; 
                        transition:all 0.5s ease;
                        border:1px solid #d1d4da; 
                        border-style:dashed; gap:5px; 
                    ">
                        <i class="fas fa-plus" style="font-size:9px; color:gray; transition:all 0.5s ease;"></i>
                        <span style="font-size:10px; color:#808080e0; font-weight:bold; transition:all 0.5s ease;">Agregar agrupamiento</span>
                    </div>
                    <div style="width:100%; position:relative; margin-top:30px; padding:0px 15px">
                        <hr>
                        <div class="bg-light" style="position:absolute; display:flex; align-items:center; justify-content:center; border-radius:15px; gap:5px; border:1px solid #d0d4da; padding:4px 10px; top:-13px">
                            <i class="fas fa-cog" style="font-size:9px"></i>
                            <span class="montserrat" style="font-size:9px">Totalización</span>
                        </div>
                        <div id="listTotalizacionAgrupamiento" style="display:flex; width:100%; gap:3px; flex-direction:column; margin-top:2px">
                            {% if configuraciones.agrupamiento is defined and configuraciones.agrupamiento|length > 0 and configuraciones.agrupamiento[0].totalizacion is defined %}
                                {% for key, totalizacion in configuraciones.agrupamiento[0].totalizacion %}
                                    <div class="totalizacionAgrupamiento" data-key="{{ key }}" id="totalizacionAgrupamiento{{ key }}" style="display:flex; align-items:center; border:1px solid #d0d4da; width:100%; padding:8px 10px; border-radius:5px; gap:7px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-tag" style="font-size:12px"></i>
                                            </div>
                                            <select class="form-control custom-select selectTotalizacionAgrupamiento" data-seleccion="{{ totalizacion.campo }}" data-clase="selectTotalizacionAgrupamiento" id="selectTotalizacionAgrupamiento{{ key }}" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" data-action="facturas--reporteador#seleccionarOpcion">
                                                {% for campo in camposTotalizacion %}
                                                    {% if campo not in camposTotalizacionAgrupacion or campo == totalizacion.campo %}
                                                        <option class="optionConfiguraciones" value="{{ campo }}" {{ (totalizacion.campo is defined and totalizacion.campo == campo) ? totalizacion.campo : '' }}>{{ campo }}</option>
                                                    {% endif %}
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div style="display:flex; position:relative; width:14px; justify-content:end">
                                            <i class="fas fa-trash text-danger" data-opc="totalizacionAgrupacion" data-key="totalizacionAgrupamiento{{ key }}" style="cursor:pointer" data-action="click->facturas--reporteador#eliminarTotalizacion"></i>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
