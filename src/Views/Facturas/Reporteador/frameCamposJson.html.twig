                                                <option class="optionConfiguraciones" value="numero" {{ (campo.tipoDato is defined and campo.tipoDato == 'numero') ? 'selectd' : '' }}>numero</option>
                                                <option class="optionConfiguraciones" value="moneda" {{ (campo.tipoDato is defined and campo.tipoDato == 'moneda') ? 'selectd' : '' }}>moneda</option>
                                                <option class="optionConfiguraciones" value="fecha" {{ (campo.tipoDato is defined and campo.tipoDato == 'fecha') ? 'selectd' : '' }}>fecha</option>
