                                                <option class="optionConfiguraciones" value="izquierda" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'izquierda') ? 'selectd' : '' }}>izquierda</option>
                                                <option class="optionConfiguraciones" value="derecha" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'derecha') ? 'selectd' : '' }}>derecha</option>
                                                <option class="optionConfiguraciones" value="centro" {{ (campo.alineacionTitulo is defined and campo.alineacionTitulo == 'centro') ? 'selectd' : '' }}>centro</option>
                                            </select>
