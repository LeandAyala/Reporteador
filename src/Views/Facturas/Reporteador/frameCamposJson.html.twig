                                    <div class="montserrat" style="position:absolute; display:flex; align-items:center; justify-content:center; font-size:9px; border-radius:10px 0px; background:#FFC107; padding:3px 10px; top:-22px; min-width:95px; left:1px">
                                        {{ campo.nombre }}
                                    </div>
                                    <div style="display:flex; width:100%; gap:7px">
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-check" style="font-size:12px"></i>
                                            </div>
                                            <input type="text" id="inputNombreCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px; pointer-events:none" placeholder="Nombre" value="{{ (campo.nombre is defined) ? campo.nombre : '' }}">
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-bookmark" style="font-size:10px"></i>
                                            </div>
                                            <input type="text" id="inputTituloCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Título" value="{{ (campo.titulo is defined) ? campo.titulo : '' }}">
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
