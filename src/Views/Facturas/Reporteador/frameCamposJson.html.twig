                                                                <i class="fas fa-check" style="font-size:12px"></i>
                                                            </div>
                                                            <input id="inputNombreParametrosRutaFrameCampo{{ campo.nombre }}{{ keyParametro }}" type="text" class="form-control" style="font-size:11px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Nombre parámetro" value="{{ keyParametro }}">
