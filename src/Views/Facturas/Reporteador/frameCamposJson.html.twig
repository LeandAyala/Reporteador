                                                <option class="optionConfiguraciones" value="derecha" {{ (campo.alineacionCampo is defined and campo.alineacionCampo == 'derecha') ? 'selectd' : '' }}>derecha</option>
                                                <option class="optionConfiguraciones" value="centro" {{ (campo.alineacionCampo is defined and campo.alineacionCampo == 'centro') ? 'selectd' : '' }}>centro</option>
                                            </select>
                                        </div>
                                        <div style="width:100%; display:flex; gap:10px; position:relative; flex:1">
                                            <div style="display:flex; align-items:center; justify-content:center; border-radius:50%; width:0px; height:0px; position:absolute; background:#E9ECEF; padding:14px; border: 1px solid #d0d4da;">
                                                <i class="fas fa-link" style="font-size:10px"></i>
                                            </div>
                                            <input type="text" id="inputRutaCampo{{ key }}" class="form-control" style="font-size:12px; border-radius:15px 7px 7px 15px; padding-left:40px" placeholder="Ruta campo" value="{{ (campo.ruta is defined and campo.ruta.nombre is defined) ? campo.ruta.nombre : '' }}">
                                        </div>
                                    </div>
                                    <div style="width:100%; position:relative; margin-top:10px; padding:0px 15px">
