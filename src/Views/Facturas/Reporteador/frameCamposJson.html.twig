                    "
                        width:20px;
                        height:20px;
                        padding:6px;
                        display:flex;
                        border-radius:50%;
                        background:#17A2B8;
                        align-items:center;
                        justify-content:center;
                        transition:all 0.5s ease;
                    ">
                        <i class="fas fa-arrows-alt-h" style="font-size:10px; color:white;"></i>
