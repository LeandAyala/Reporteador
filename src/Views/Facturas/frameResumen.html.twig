<div style="display:flex; align-items:center; justify-content:end;">
    <div style="width:0px; position:relative">
        <div id="resumenGruposContables" style="position:absolute; height:200px; width:272px; border:1px solid #d0d4da; background:white; z-index:1;left: -7px; top: -99px; border-left: 7px solid #17A; border-radius: 10px 0px 0px 10px; transition:all 0.5s ease">
            <div style="position:relative; width:0px">
                <div data-action="click->consumo--reporteador#showResumen" style=
                "
                    top: 57px; 
                    width: 10px; 
                    left: -16px; 
                    height: 72px; 
                    display:flex; 
                    cursor:pointer; 
                    background: #17A; 
                    position:absolute; 
                    align-items:center; 
                    justify-content:center;
                    border-radius: 10px 0px 0px 10px; 
                ">
                    <i class="fas fa-caret-left" style="font-size:11px; color:white; margin-left:6px"></i>
                </div>
                <div style="position:relative; overflow:hidden; width:250px; height:200px; display:flex; align-items:center; justify-content:center">
                    <canvas id="grafica" style="width: 200px; height: 170px; display: visible; max-width: 200px; max-height: 170px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div style="position:relative; width:500px; z-index:2; border-radius:10px; background:white">
        <table border="0" cellpadding="0" cellspacing="0" style="width:100%">
            <tr class="text-primary">
                <td>
                    <div class="bg-light montserrat" style="border:1px solid #d0d4da; width:100%; height:32px; display:flex; align-items:center; justify-content:center; border-bottom:none; border-right:none; font-size:11px; border-radius:10px 0px 0px 0px">
                        <i class="fas fa-tags" style="font-size:11px"></i>
                        <span style="font-size:11px; margin-left:5px">Grupo contable</span>
                    </div>
                </td>
                <td>
                    <div class="bg-light montserrat" style="border:1px solid #d0d4da; width:100%; height:32px; display:flex; align-items:center; justify-content:center; border-bottom:none; font-size:11px; border-radius:0px 10px 0px 0px">
                        <i class="fas fa-coins" style="font-size:11px"></i>
                        <span style="font-size:11px; margin-left:5px">Existencias</span>
                    </div>
                </td>
            </tr>
            {% set totalExistencias = 0 %}
            {% for key, grupo in listResumenGruposContables %}
                <tr>
                    <td style="font-size:12px; text-align:center; border:1px solid #d0d4da; padding:3px 10px">{{ key }}</td>
                    <td style="font-size:12px; text-align:right; border:1px solid #d0d4da; padding:3px 10px">{{ grupo|number_format(2, ',', '.') }}</td>
                </tr>
                {% set totalExistencias = totalExistencias + grupo %}
            {% endfor %}
            <tr>
                <td>
                    <div class="bg-light" style="background:#f8f9fa; display:flex; align-items:center; justify-content:right; padding:0px 10px 0px 12px; height:34px; font-size:12px; border:1px solid #d0d4da; border-right:none; border-top:none; border-radius:0px 0px 0px 10px">
                        <div>
                            <div class="ripple" style="position:relative">
                                <i 
                                    style="position: absolute; top:1px; left:0px; font-size:12px" 
                                    class="fas fa-info-circle text-primary" 
                                ></i>
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; justify-content:center; gap:7px">
                            <span class="montserrat text-primary" style="margin-left:8px; font-size:10px; margin-top:1px">Total</span>
                            <i class="fas fa-angle-double-right text-primary" style="font-size:9px; margin-top:1px"></i>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="bg-light" style="background:#f8f9fa; display:flex; align-items:center; justify-content:right; padding:0px 10px 0px 12px; height:34px; font-size:12px; border:1px solid #d0d4da; border-left:none; border-top:none; border-radius:0px 0px 10px 0px">
                        <span class="montserrat" style="font-size:10px">{{ totalExistencias|number_format(2, ',', '.') }}</span>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>